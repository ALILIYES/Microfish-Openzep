# ==============================================
# OpenZep Configuration
# ==============================================

# --- LLM (required) ---
# 任何 OpenAI 兼容的 API 均可：SiliconFlow, OpenAI, DeepSeek, 本地 Ollama 代理等。
# 如果在 Docker 内运行且 LLM 网关/代理在宿主机上，
# 请使用 http://host.docker.internal:PORT/v1 替代 localhost / 127.0.0.1。
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_SMALL_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Embedder (optional) ---
# 如果你的 LLM 提供商支持 embedding（SiliconFlow, OpenAI, Ollama），
# 留空以下变量将自动复用 LLM_API_KEY / LLM_BASE_URL。
#
# 如果你使用 Anthropic Claude 直连（不支持 embedding），
# 需在此单独配置支持 embedding 的服务。
#
# EMBEDDER_API_KEY=
# EMBEDDER_BASE_URL=
EMBEDDER_MODEL=BAAI/bge-m3

# --- Graph DB ---
GRAPH_DB=neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# --- SQLite ---
SQLITE_PATH=openzep.db

# --- Auth (optional) ---
# 如果设置，所有 API 调用需要: Authorization: Bearer <API_KEY>
# 留空则禁用认证。
# API_KEY=your-openzep-api-key
