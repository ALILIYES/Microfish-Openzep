# ==============================================
# MicroFish-Docker 统一配置文件
# ==============================================
# 复制此文件为 .env 并填入你的配置：
#   cp .env.example .env
# ==============================================

# --- LLM (必填) ---
# 支持任意 OpenAI 兼容 API
# 推荐：DeepSeek / SiliconFlow / Qwen (阿里百炼) / OpenAI
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- LLM 小模型（可选，OpenZep 用于轻量任务）---
# 留空则复用 LLM_MODEL
# LLM_SMALL_MODEL=deepseek-chat

# --- Embedder（可选）---
# 如果你的 LLM 不支持 embedding（如 Anthropic Claude），
# 需单独配置支持 embedding 的服务（SiliconFlow / OpenAI）
# 留空则复用 LLM_API_KEY / LLM_BASE_URL
# EMBEDDER_API_KEY=sk-your-embedder-key
# EMBEDDER_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDER_MODEL=BAAI/bge-m3

# --- Neo4j 图数据库 ---
NEO4J_PASSWORD=password123

# --- OpenZep API Key（可选）---
# MiroFish 会通过此 Key 访问 OpenZep
# 留空则 OpenZep 不启用鉴权，MiroFish 传任意值即可
# API_KEY=mirofish-local

# --- 加速 LLM（可选，MiroFish 功能）---
# 模拟加速阶段使用的独立 LLM 配置, 留空复用主 LLM
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
